# Copy to .env.local and fill in.
# Resend API key (https://resend.com). Leave empty in development to log quotes to the console instead of sending.
RESEND_API_KEY=
# Address that receives quote requests
QUOTE_TO_EMAIL=quotes@speedshipping.example
# Verified sender on your Resend domain
QUOTE_FROM_EMAIL=Speed Shipping <noreply@speedshipping.example>
# Public site URL, used for metadata and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
